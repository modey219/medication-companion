<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup is disabled (android:allowBackup="false"). These rules are kept
    as an explicit, documented statement that no app data is backed up.
    See AGENTS.md > Privacy and security.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
