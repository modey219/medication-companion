# Medication Companion assistant backend - example configuration.
#
# Copy to `.env` for `wrangler dev` and fill in real values locally.
# NEVER commit `.env` or any real key; the repository root .gitignore already
# ignores `backend/.env` and `backend/.env.*`.
#
# For a deployed Worker the same names are used, but secrets must be set with:
#   wrangler secret put LLM_API_KEY
#   wrangler secret put PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON
# and plain settings can live in `[vars]` in wrangler.toml.

# --- Provider-agnostic LLM client -------------------------------------------
# "openai-compatible" | "mock"
LLM_PROVIDER=openai-compatible

# Any chat-completions-compatible model name. Placeholder.
LLM_MODEL=REPLACE_ME_MODEL

# The API key. Placeholder only; the real key lives only on the backend.
LLM_API_KEY=REPLACE_ME_API_KEY

# Base URL including the API version path, without a trailing slash.
LLM_BASE_URL=https://api.openai.com/v1

# Upper bound on generated tokens, and the request timeout in milliseconds.
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_REVIEW_TOKENS=400
# Optional thinking hint for reasoning models (minimal|low|medium|high). Leave unset
# when the provider does not support it; the adapter then sends no such field.
LLM_REASONING_EFFORT=
REQUEST_TIMEOUT_MS=45000

# Request validation limits.
MAX_REQUEST_BYTES=65536
MAX_MESSAGES=20
MAX_MESSAGE_CHARS=2000
MAX_MEDICATION_CONTEXT_CHARS=4000
# Cap on the serialized structured patient context (personalized mode).
MAX_CONTEXT_CHARS=12000

# Abuse protection: per-install per-minute, per-install per-day and a global
# daily safety valve shared by every install.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=50
RATE_LIMIT_GLOBAL_PER_DAY=2000

# Local emergency number shown in the server-side emergency reply.
# TODO(clinical-review, T9): replace the placeholder with the real local number.
EMERGENCY_NUMBER=REPLACE_ME_EMERGENCY_NUMBER

# Play Integrity verification (abuse protection for requests coming from the
# genuine app). "off" by default; set to "enforce" once the Google Cloud
# service account and the app-side integrity token are wired up.
PLAY_INTEGRITY_MODE=off
PLAY_INTEGRITY_PROJECT_NUMBER=REPLACE_ME_GOOGLE_CLOUD_PROJECT_NUMBER
PLAY_INTEGRITY_PACKAGE_NAME=REPLACE_ME_APPLICATION_ID
# JSON of a Google service account with the Play Integrity API enabled.
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=REPLACE_ME_SERVICE_ACCOUNT_JSON
